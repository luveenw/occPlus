Package: occPlus
Type: Package
Title: Fitting occupancy models for eDNA reads data
Version: 0.1.0
Authors@R: c(
    person(
      "Alex", "Diana",
      email = "ad23269@essex.ac.uk",
      role = c("aut", "cre")
